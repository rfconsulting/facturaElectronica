NODE_ENV=development
PORT=3000
TRUST_PROXY=0
SESSION_SECRET=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_64_CARACTERES_123456789
# Clave AES-256 de 64 caracteres hexadecimales para cifrar secretos TOTP.
MFA_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES_ANTES_DE_PRODUCCION
# Clave independiente para cifrar credenciales de proveedores.
CONFIG_MASTER_KEY=REEMPLAZAR_CON_OTROS_64_CARACTERES_HEXADECIMALES
APP_PUBLIC_URL=http://localhost:3000
# Token de al menos 32 caracteres para proteger /internal/metrics. Obligatorio en producción.
OBSERVABILITY_TOKEN=REEMPLAZAR_CON_TOKEN_ALEATORIO_DE_MONITOREO
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=factura_electronica
DB_USER=factura_app
DB_PASSWORD=una-clave-de-base-de-datos-segura
DB_CONNECTION_LIMIT=10
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Reemplazar-por-una-clave-muy-segura

# Fallback inicial de The Factory HKA. Usuario y contraseña deben corresponder a HKA_ENVIRONMENT.
# Tanto demo como production requieren credenciales de servicios web. Al guardar desde el panel prevalece la DB cifrada.
HKA_ENVIRONMENT=demo
HKA_USERNAME=
HKA_PASSWORD=
HKA_BRANCH_CODE=0000
HKA_BRANCH_TYPE=1
HKA_BILLING_POINT=001
HKA_REQUEST_TIMEOUT_MS=30000
